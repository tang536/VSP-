# ---------- 签名与密钥（绝不能提交）----------
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
keystore.properties
local.properties
.env
.env.*

# ---------- Gradle / Android 构建产物 ----------
.gradle/
apk/.gradle/
build/
apk/build/
apk/app/build/
*.apk
*.aab
*.ap_
captures/
.cxx/

# ---------- 前端 ----------
node_modules/
web/front/node_modules/
dist/
web/front/dist/
# Gitee 兜底更新源：版本索引要入库（同一层级的构建产物仍忽略）
!apk/dist/
apk/dist/*
!apk/dist/latest.json
.vite/
*.tsbuildinfo

# ---------- .NET ----------
bin/
obj/
web/back/bin/
web/back/obj/
*.user
*.suo

# ---------- Windows 桌面端 ----------
desktop/publish/
desktop/packaging/runtime/
desktop/packaging/cache/
# 只有更新索引入库；安装包走 GitHub Release 资产分发，不进仓库
# （单包 ~84MB，进 git 会永久撑大历史，GitHub 也会报 GH001 大文件告警）
!desktop/dist/
desktop/dist/*
!desktop/dist/latest.json
desktop/dist/*.msi
desktop/dist/*.wixpdb

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- IDE / 系统 ----------
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ---------- 工具会话数据 ----------
.workbuddy/
.playwright-cli/

# ---------- 临时文件 ----------
*.log
*.tmp
_*.json
