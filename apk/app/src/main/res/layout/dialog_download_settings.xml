<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下载与解析设置"
            android:textColor="#e8eaed"
            android:tag="text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下载命名模板"
            android:textColor="#e8eaed"
            android:tag="text"
            android:textSize="14sp"
            android:layout_marginTop="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="决定下载文件的保存名称。可用占位符：{title} 标题、{id} 视频 ID、{uploader} 作者、{quality} 清晰度、{source} 来源、{date} 日期、{ext} 扩展名。留空会恢复默认值。"
            android:textColor="#8b909a"
            android:tag="dim"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/name_template_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="{title} [{quality}]"
            android:textColor="#e8eaed"
            android:textSize="13sp"
            android:hint="{title} [{quality}]"
            android:importantForAutofill="no"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="解析缓存有效期（秒）"
            android:textColor="#e8eaed"
            android:tag="text"
            android:textSize="14sp"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="同一链接在有效期内再次解析会直接使用缓存，不会重新请求站点。填 0 表示每次都重新解析；默认 600 秒（10 分钟）。直链过期后播放器仍会自动重解析。"
            android:textColor="#8b909a"
            android:tag="dim"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/parse_ttl_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:text="600"
            android:textColor="#e8eaed"
            android:textSize="13sp"
            android:importantForAutofill="no"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
