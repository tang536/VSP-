<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#171a21"
    android:tag="card"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="1px"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/br_kind"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_video"
        android:tag="accent_icon"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/br_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="媒体资源"
            android:textColor="#e8eaed"
            android:tag="text"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/br_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="https://…"
            android:textColor="#8b909a"
            android:tag="dim"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/br_download"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="下载"
        android:textColor="#f97316"
        android:tag="accent"
        android:textSize="12sp"
        android:padding="8dp" />
</LinearLayout>
