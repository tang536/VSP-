<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#171a21"
    android:tag="card"
    android:paddingStart="12dp"
    android:paddingEnd="6dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="6dp">

    <ImageView
        android:id="@+id/fm_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_video"
        android:tag="icon"
        android:scaleType="fitCenter"
        android:padding="9dp"
        android:background="#1f232c"
        android:contentDescription="文件类型" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">
        <TextView
            android:id="@+id/fm_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#e8eaed"
            android:tag="text"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/fm_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8b909a"
            android:tag="dim"
            android:textSize="11sp"
            android:singleLine="true"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/fm_open"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_resume"
        android:tag="accent_icon"
        android:scaleType="fitCenter"
        android:padding="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="播放" />

    <ImageButton
        android:id="@+id/fm_delete"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_delete"
        android:tag="danger_icon"
        android:scaleType="fitCenter"
        android:padding="8dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="删除" />
</LinearLayout>
