<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#171a21"
    android:tag="card"
    android:padding="10dp"
    android:layout_marginBottom="1px">
    <CheckBox
        android:id="@+id/t_check"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:buttonTint="#f97316"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/t_thumb"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:scaleType="centerCrop"
        android:background="#1f232c"
        android:tag="thumb"
        android:contentDescription="封面" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp">
        <TextView
            android:id="@+id/t_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#e8eaed"
            android:tag="text"
            android:textSize="13sp"
            android:singleLine="true"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/t_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8b909a"
            android:tag="dim"            android:textSize="11sp"
            android:singleLine="true"
            android:layout_marginTop="2dp" />
        <!-- 进度条与「已下载 / 总大小 · 速度」放在同一行，一眼就能对上当前进度 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <ProgressBar
                android:id="@+id/t_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="0" />

            <TextView
                android:id="@+id/t_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#8b909a"
                android:tag="dim"
                android:textSize="10sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:id="@+id/t_open"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:gravity="center"
        android:text="打开"
        android:textColor="#f97316"
        android:tag="accent"
        android:textSize="12sp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone" />
    <ImageButton
        android:id="@+id/t_pause"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_pause"
        android:tag="accent_icon"
        android:scaleType="fitCenter"
        android:padding="7dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="暂停或继续"
        android:visibility="gone"
        android:layout_marginStart="4dp" />
</LinearLayout>
