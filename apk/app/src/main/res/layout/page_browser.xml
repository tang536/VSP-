<?xml version="1.0" encoding="utf-8"?>
<!-- 内置浏览器独立页面：地址栏 + WebView 容器 + 可拖动悬浮资源窗 + 底部导航。
     悬浮窗在嗅探到资源时自动弹出，可拖动、可收成小圆钮、可关闭删除。
     底部导航：上一级 / 下一级（可返回时才显示）、窗口列表、主页。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:tag="bg">

    <!-- 顶部返回栏已移除：浏览器页只保留地址栏、网页、底部导航与资源浮窗，返回用系统返回键/手势 -->

    <!-- 播放器：浏览器里打开视频时挂到这里 -->
    <FrameLayout
        android:id="@+id/player_slot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 地址栏：仅接受 http(s)，搜索图标触发 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#171a21"
        android:tag="card"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/browser_url"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:hint="输入 http(s) 网址或搜索词"
            android:textColorHint="#8b909a"
            android:textColor="#e8eaed"
            android:background="#0f1115"
            android:tag="input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="textUri" />

        <ImageButton
            android:id="@+id/browser_go"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_search"
            android:scaleType="fitCenter"
            android:padding="10dp"
            android:background="#f97316"
            android:contentDescription="搜索" />
    </LinearLayout>

    <!-- 网页区 + 悬浮资源窗 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 多窗口宿主：每个窗口一个独立 WebView，由代码动态挂进来 -->
        <FrameLayout
            android:id="@+id/browser_view_host"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/browser_progress"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:indeterminate="false"
            android:max="100"
            android:visibility="gone"
            style="?android:attr/progressBarStyleHorizontal" />

        <!-- 可拖动资源浮窗：嗅探到资源自动弹出 -->
        <LinearLayout
            android:id="@+id/browser_res_float"
            android:layout_width="292dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical"
            android:background="#171a21"
            android:tag="card"
            android:elevation="10dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/browser_res_header"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="6dp"
                android:background="#1f232c"
                android:tag="soft">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_video"
                    android:tag="accent_icon"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/browser_res_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:text="可下载资源 (0)"
                    android:textColor="#e8eaed"
                    android:tag="text"
                    android:textSize="12sp"
                    android:singleLine="true" />

                <ImageButton
                    android:id="@+id/browser_res_hide"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_chevron"
                    android:tag="icon"
                    android:scaleType="fitCenter"
                    android:padding="7dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="收起" />

                <ImageButton
                    android:id="@+id/browser_res_close"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_close"
                    android:tag="danger_icon"
                    android:scaleType="fitCenter"
                    android:padding="7dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="删除资源" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/browser_res_list"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/browser_res_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="浏览网页时自动嗅探可下载的视频 / 音频"
                android:textColor="#8b909a"
                android:tag="dim"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="10dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 收起后的小圆钮：点一下重新展开浮窗 -->
        <TextView
            android:id="@+id/browser_res_fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:background="#f97316"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:elevation="10dp"
            android:visibility="gone"
            android:text="资源 0" />
    </FrameLayout>

    <!-- 浏览器底部导航：上一级 / 下一级 / 窗口 / 主页 -->
    <LinearLayout
        android:id="@+id/browser_nav"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#171a21"
        android:tag="card"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageButton
            android:id="@+id/browser_back"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:src="@drawable/ic_arrow_left"
            android:tag="icon"
            android:scaleType="fitCenter"
            android:padding="13dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="上一级"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/browser_forward"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:src="@drawable/ic_arrow_right"
            android:tag="icon"
            android:scaleType="fitCenter"
            android:padding="13dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="下一级"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/browser_tabs"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:src="@drawable/ic_windows"
            android:tag="icon"
            android:scaleType="fitCenter"
            android:padding="11dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="窗口列表" />

        <ImageButton
            android:id="@+id/browser_home"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:src="@drawable/ic_home"
            android:tag="icon"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="浏览器主页" />
    </LinearLayout>
</LinearLayout>
