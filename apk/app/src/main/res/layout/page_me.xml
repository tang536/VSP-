<?xml version="1.0" encoding="utf-8"?>
<!-- 最高级页面：不显示返回上一级；下载队列只留入口，队列内容在新页面 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:tag="bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:id="@+id/player_slot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- 本地用户：点击头像看大图，长按大图更换 / 恢复默认；头像为方形 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#171a21"
                android:tag="card"
                android:padding="16dp"
                android:layout_marginBottom="18dp">
                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_avatar_default"
                    android:scaleType="centerCrop"
                    android:background="#1f232c"
                    android:tag="thumb"
                    android:contentDescription="用户头像" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本地用户"
                        android:textColor="#e8eaed"
                        android:tag="text"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点击查看大图 · 长按大图可更换头像"
                        android:textColor="#8b909a"
                        android:tag="dim"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 下载队列：入口，点击打开新页面展示下载中 / 已完成 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下载"
                android:textColor="#8b909a"
                android:tag="dim"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/row_queue"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#171a21"
                android:tag="card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="18dp"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_queue"
                    android:tag="icon"
                    android:scaleType="fitCenter" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="下载队列"
                    android:textColor="#e8eaed"
                    android:tag="text"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp" />
                <TextView
                    android:id="@+id/queue_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="查看 ›"
                    android:textColor="#8b909a"
                    android:tag="dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 设置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置"
                android:textColor="#8b909a"
                android:tag="dim"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/row_dir"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#171a21"
                android:tag="card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="1px">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_folder"
                    android:tag="icon"
                    android:scaleType="fitCenter" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="下载目录"
                    android:textColor="#e8eaed"
                    android:tag="text"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp" />
                <TextView
                    android:id="@+id/dir_path"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="查看"
                    android:textColor="#8b909a"
                    android:tag="dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_theme"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#171a21"
                android:tag="card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="1px">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_theme"
                    android:tag="icon"
                    android:scaleType="fitCenter" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="深色模式"
                    android:textColor="#e8eaed"
                    android:tag="text"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp" />
                <Switch
                    android:id="@+id/theme_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_storage"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#171a21"
                android:tag="card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginBottom="1px">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_storage"
                    android:tag="icon"
                    android:scaleType="fitCenter" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="存储空间"
                    android:textColor="#e8eaed"
                    android:tag="text"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="管理 ›"
                    android:textColor="#8b909a"
                    android:tag="dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 检查更新：右侧显示版本号，点击检查是否有新版本 -->
            <LinearLayout
                android:id="@+id/row_update"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="#171a21"
                android:tag="card"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_update"
                    android:tag="icon"
                    android:scaleType="fitCenter" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="检查更新"
                    android:textColor="#e8eaed"
                    android:tag="text"
                    android:textSize="14sp"
                    android:layout_marginStart="12dp" />
                <ProgressBar
                    android:id="@+id/update_progress"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:indeterminate="true"
                    android:indeterminateTint="#f97316"
                    android:visibility="gone"
                    android:layout_marginEnd="6dp" />
                <TextView
                    android:id="@+id/update_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v1.4"
                    android:textColor="#8b909a"
                    android:tag="dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="VSP 解析 v1.4 · yt-dlp + 本地封装"
                android:textColor="#8b909a"
                android:tag="dim"
                android:textSize="11sp"
                android:gravity="center"
                android:paddingTop="28dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
