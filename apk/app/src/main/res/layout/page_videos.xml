<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:tag="bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#171a21"
        android:tag="card"
        android:paddingStart="6dp"
        android:paddingEnd="14dp">
        <ImageButton
            android:id="@+id/video_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:tag="icon"
            android:scaleType="fitCenter"
            android:padding="9dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="提取视频配乐"
            android:textColor="#e8eaed"
            android:tag="text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/video_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="点击视频播放 · 点封面右下角音符图标提取配乐"
        android:textColor="#8b909a"
        android:tag="dim"
        android:textSize="11sp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="8dp" />

    <FrameLayout
        android:id="@+id/player_slot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/video_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clipToPadding="false"
            android:scrollbars="none" />
        <TextView
            android:id="@+id/video_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="还没有扫描到视频\n先去扫描本地媒体"
            android:textColor="#8b909a"
            android:tag="dim"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
