<?xml version="1.0" encoding="utf-8"?>
<!-- 开场动画：只有冷启动那一次盖在最上层，图标占 C 位、名称在下，
     完全仿系统 App（QQ / 微信）的启动观感，挂后台回来不会再出现。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f1115"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/splash_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/splash_icon"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="应用图标" />

        <TextView
            android:id="@+id/splash_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="VSP 解析"
            android:textColor="#e8eaed"
            android:textSize="19sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:id="@+id/splash_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="视频 · 图片 · 音频 一站式解析"
            android:textColor="#71767f"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
