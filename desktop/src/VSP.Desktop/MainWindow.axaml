<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VSP.Desktop.Views"
        xmlns:vm="clr-namespace:VSP.Desktop"
        x:Class="VSP.Desktop.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="全能工具箱"
        Width="1080" Height="620" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        DragDrop.AllowDrop="True"
        Background="{DynamicResource AppBackground}">
    <Grid x:Name="RootContent" RowDefinitions="Auto,*" Opacity="0"
          RenderTransform="translateY(12px)">
        <Grid.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.36" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" />
            </Transitions>
        </Grid.Transitions>
        <!-- 顶栏：与 Web 端 topbar 同一结构（橙色 V 品牌 + 导航 + 外观）；播放器全屏时隐藏 -->
        <Border Grid.Row="0" Height="56" IsVisible="{Binding !IsPlayerFullScreen}"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="24,0,24,0" Spacing="10" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="2" Background="{DynamicResource Accent}">
                            <TextBlock Text="V" Foreground="{DynamicResource OnAccent}" FontSize="15"
                                       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="全能工具箱" Classes="h2" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AppVersion}" Classes="dim" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Classes="nav" Classes.active="{Binding IsHome}" Command="{Binding ShowHomeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconHome}" VerticalAlignment="Center" />
                                <TextBlock Text="首页" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsLocal}" Command="{Binding ShowLocalCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconFolder}" VerticalAlignment="Center" />
                                <TextBlock Text="本地文件" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Classes.active="{Binding IsMeNav}" Command="{Binding ShowMeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource IconUser}" VerticalAlignment="Center" />
                                <TextBlock Text="我的" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Spacing="10" Margin="0,0,24,0">
                    <Button Classes="ghost small" Command="{Binding ShowHistoryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource IconHistory}" />
                            <TextBlock Text="历史解析" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost small" Command="{Binding ToggleThemeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{Binding ThemeIcon}" />
                            <TextBlock Text="{Binding ThemeText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <views:HomeView x:Name="PageHome" Classes="page" DataContext="{Binding}" IsVisible="{Binding IsHome}" />
            <views:LocalView x:Name="PageLocal" Classes="page" DataContext="{Binding}" IsVisible="{Binding IsLocal}" />
            <views:MeView x:Name="PageMe" Classes="page" DataContext="{Binding}" IsVisible="{Binding IsMePage}" />
            <views:QueueView x:Name="PageQueue" Classes="page" DataContext="{Binding}" IsVisible="{Binding IsQueuePage}" />
            <views:StorageView x:Name="PageStorage" Classes="page" DataContext="{Binding}" IsVisible="{Binding IsStoragePage}" />
            <views:LanView x:Name="PageLan" Classes="page" DataContext="{Binding}" IsVisible="{Binding IsLanPage}" />
            <Panel x:Name="PagePreview" Classes="page" IsVisible="{Binding IsPreviewPage}">
                <views:PreviewView DataContext="{Binding Preview}" />
            </Panel>
        </Grid>
    </Grid>
</Window>
