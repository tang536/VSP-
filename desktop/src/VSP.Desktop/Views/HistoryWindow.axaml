<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VSP.Desktop"
        x:Class="VSP.Desktop.Views.HistoryWindow"
        x:DataType="vm:MainViewModel"
        Title="历史解析"
        Width="640" Height="480" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Grid RowDefinitions="Auto,*,Auto" Margin="24,20">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
            <PathIcon Grid.Column="0" Data="{StaticResource IconHistory}" Width="18" Height="18"
                      Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="历史解析" Classes="h1" VerticalAlignment="Center" />
            <Border Grid.Column="2" Classes="chip" VerticalAlignment="Center" Padding="8,3">
                <TextBlock Text="{Binding RecentSummary}" Classes="dim" FontSize="11" />
            </Border>
            <Button Grid.Column="4" Classes="ghost small" Command="{Binding ClearHistoryCommand}"
                    IsVisible="{Binding HasRecent}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" />
                    <TextBlock Text="清空" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <Panel>
                <ItemsControl ItemsSource="{Binding RecentItems}" IsVisible="{Binding HasRecent}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentItemViewModel">
                        <Button Command="{Binding UseCommand}" Padding="14,11" Cursor="Hand"
                                Background="Transparent" BorderThickness="0,0,0,1"
                                BorderBrush="{DynamicResource Line}" CornerRadius="0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Center">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <TextBlock Grid.Column="0" Text="{Binding Url}" FontSize="12"
                                           Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTip.Tip="{Binding Url}" />
                                <PathIcon Grid.Column="1" Data="{StaticResource IconChevron}" Width="13" Height="13"
                                          Foreground="{DynamicResource InkDim}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel IsVisible="{Binding !HasRecent}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,90,0,0" Spacing="8">
                <PathIcon Data="{StaticResource IconHistory}" Width="32" Height="32"
                          Foreground="{DynamicResource InkDim}" HorizontalAlignment="Center" />
                <TextBlock Text="还没有解析记录" Classes="dim" HorizontalAlignment="Center" />
            </StackPanel>
            </Panel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="点击任意记录即可重新解析" Classes="dim" FontSize="11" Margin="0,10,0,0" />
    </Grid>
</Window>
