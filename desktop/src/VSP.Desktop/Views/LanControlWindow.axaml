<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VSP.Desktop"
        x:Class="VSP.Desktop.Views.LanControlWindow"
        x:DataType="vm:MainViewModel"
        Title="远控申请"
        Width="410" Height="280"
        MinWidth="380" MinHeight="250"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Grid Margin="24,22" RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="🖥 收到远控申请" Classes="h2" />
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,16,0,0">
            <TextBlock Text="{Binding IncomingControl.Name, StringFormat=设备：{0}}" Classes="rowLabel" FontSize="15" />
            <TextBlock Text="{Binding IncomingControl.Ip, StringFormat=地址：{0}}" Classes="sub" />
            <TextBlock Text="该设备请求查看并控制本机屏幕。允许后对方可实时查看屏幕并发送点击、滑动和按键。"
                       Classes="dim" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" Margin="0,16,0,0">
            <Button Classes="ghost" Content="拒绝" Command="{Binding LanRejectControlCommand}" />
            <Button Classes="primary" Content="允许控制" Command="{Binding LanAcceptControlCommand}" />
        </StackPanel>
    </Grid>
</Window>
