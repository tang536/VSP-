<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VSP.Desktop"
        x:Class="VSP.Desktop.Views.LanDevicesWindow"
        x:DataType="vm:MainViewModel"
        Title="附近设备"
        Width="440" Height="520"
        MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Grid Margin="24,20" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
            <TextBlock Text="附近设备" Classes="h2" />
            <TextBlock Text="{Binding LanStatus}" Classes="sub" TextWrapping="Wrap" />
            <TextBlock Text="{Binding LanLocalIp, StringFormat=本机地址：{0}}" Classes="dim" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
                <ItemsControl ItemsSource="{Binding LanDevices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="card" Padding="12" Margin="0,0,0,2">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="6"
                                            Background="{DynamicResource AccentSoft}" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{DynamicResource Accent}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontSize="14" />
                                        <TextBlock Text="{Binding Ip}" Foreground="{DynamicResource InkDim}" FontSize="11" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="primary small" Width="64" Height="32" Content="连接"
                                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).LanConnectCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="未发现设备？用对方「本机地址」手动连接 ↓" Classes="dim"
                           HorizontalAlignment="Center" Margin="0,12,0,6" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
            <TextBox PlaceholderText="输入对方 IP，如 192.168.1.5" Text="{Binding LanManualIp}"
                     Height="40" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
            <Button Classes="primary" Width="96" Height="40" Content="手动连接"
                    Command="{Binding LanAddManualCommand}" />
        </StackPanel>
    </Grid>
</Window>
