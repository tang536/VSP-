<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VSP.Desktop"
        x:Class="VSP.Desktop.Views.LanPairWindow"
        x:DataType="vm:MainViewModel"
        Title="连接申请"
        Width="380" Height="240"
        MinWidth="360" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Grid Margin="24,22" RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.Row="0" Text="🔗 收到连接申请" Classes="h2" />
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,16,0,0">
            <TextBlock Text="{Binding IncomingPair.Name, StringFormat=设备：{0}}" Classes="rowLabel" FontSize="15" />
            <TextBlock Text="{Binding IncomingPair.Ip, StringFormat=地址：{0}}" Classes="sub" />
            <TextBlock Text="是否同意该设备连接并互传文件、查看屏幕？" Classes="dim" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                    VerticalAlignment="Bottom" Margin="0,16,0,0">
            <Button Classes="ghost" Content="拒绝" Command="{Binding LanRejectPairCommand}" />
            <Button Classes="primary" Content="同意连接" Command="{Binding LanAcceptPairCommand}" />
        </StackPanel>
    </Grid>
</Window>
