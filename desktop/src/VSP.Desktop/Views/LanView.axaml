<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VSP.Desktop"
             xmlns:core="clr-namespace:VSP.Core;assembly=VSP.Core"
             xmlns:views="clr-namespace:VSP.Desktop.Views"
             x:Class="VSP.Desktop.Views.LanView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackground}">
    <UserControl.Resources>
        <views:BytesToBitmapConverter x:Key="BytesToBitmap" />
    </UserControl.Resources>

    <Grid Margin="28,24" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="互传与远控" Classes="h1" />
            <TextBlock Text="{Binding LanStatus}" Classes="sub" Margin="0,6,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <!-- 未选中设备：引导打开附近设备弹窗 -->
            <Border Classes="card" Padding="32" IsVisible="{Binding !HasSelectedLanDevice}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" MaxWidth="520">
                    <TextBlock Text="⌁" FontSize="46" Foreground="{DynamicResource Accent}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="连接附近设备" Classes="h2" HorizontalAlignment="Center" />
                    <TextBlock Text="确保两台设备连接同一 Wi-Fi。发现不到时可用对方的本机 IP 直接连接。"
                               Classes="sub" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Classes="primary" Content="查找附近设备" HorizontalAlignment="Center"
                            Padding="24,10" Command="{Binding OpenLanDevicesCommand}" />
                    <TextBlock Text="{Binding LanLocalIp, StringFormat=本机地址：{0}}" Classes="dim"
                               HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding LanPairing}" Width="160" Height="4" />
                </StackPanel>
            </Border>

            <!-- 操作区（已连接设备） -->
            <Border Classes="card" Padding="18" IsVisible="{Binding HasSelectedLanDevice}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                IsVisible="{Binding !IsRemoteControlling}">
                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="4" Padding="8,4">
                            <TextBlock Text="{Binding SelectedLanDevice.Name}" Classes="h2" VerticalAlignment="Center" />
                        </Border>
                        <Button Classes="ghost small" Content="切换设备" Command="{Binding OpenLanDevicesCommand}" />
                        <TextBlock Text="{Binding LanBreadcrumb}" Classes="h2" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button Classes="ghost small" Content="上级" Command="{Binding LanBackDirCommand}" />
                        <Button Classes="primary small" Content="发送文件" Command="{Binding LanUploadCommand}" />
                        <Button Classes="ghost small" Content="开始远控" Command="{Binding LanStartControlCommand}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" MaxHeight="180" Margin="0,12,0,0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding !IsRemoteControlling}">
                        <ItemsControl ItemsSource="{Binding LanRemoteFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="8,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Width="16" VerticalAlignment="Center"
                                                       Text="▸" IsVisible="{Binding IsDir}" Foreground="{DynamicResource Accent}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="rowLabel" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Classes="ghost small" Content="打开" IsVisible="{Binding IsDir}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).LanOpenDirCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="2" Classes="ghost small" Content="接收" IsVisible="{Binding !IsDir}"
                                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).LanDownloadCommand}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,12,0,0" RowDefinitions="*,Auto" IsVisible="{Binding IsRemoteControlling}">
                        <Border Grid.Row="0" Background="#000000" CornerRadius="6" ClipToBounds="True"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="220">
                            <Image x:Name="RemoteScreen"
                                   Source="{Binding LanScreenBytes, Converter={StaticResource BytesToBitmap}}"
                                   Stretch="Uniform" StretchDirection="Both" Cursor="Hand" />
                        </Border>
                        <TextBlock Grid.Row="0" Text="远控画面加载中…" Classes="dim"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding LanScreenBytes, Converter={x:Static ObjectConverters.IsNull}}" />
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button Classes="ghost small" Content="← 返回" Command="{Binding LanKeyCommand}" CommandParameter="back" />
                            <Button Classes="ghost small" Content="⌂ 主页" Command="{Binding LanKeyCommand}" CommandParameter="home" />
                            <Button Classes="ghost small" Content="▤ 多任务" Command="{Binding LanKeyCommand}" CommandParameter="recent" />
                            <Button Classes="ghost small" Content="⛶ 全屏" Click="FullScreen_Click" />
                            <Button Classes="ghost small" Content="■ 停止远控" Command="{Binding LanStopControlCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
