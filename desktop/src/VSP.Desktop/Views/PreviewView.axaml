<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
             xmlns:views="clr-namespace:VSP.Desktop.Views"
             xmlns:vm="clr-namespace:VSP.Desktop.Views"
             x:Class="VSP.Desktop.Views.PreviewView"
             x:DataType="vm:PreviewViewModel"
             Background="{DynamicResource AppBackground}">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 头部：返回 + 标题 -->
        <Border Grid.Row="0" Height="48" Padding="16,0" Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                IsVisible="{Binding ShowHeader}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Grid.Column="0" Classes="ghost small" Command="{Binding CloseCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <PathIcon Data="{StaticResource IconBack}" Width="13" Height="13" />
                        <TextBlock Text="返回" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="h1" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="预览" Classes="dim" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 媒体区：纯黑底。VideoView 是原生子窗口，Avalonia 控件叠不上去，
             所以视频控制条放在下面单独一行；音频没有原生窗口，控制条直接叠在画面底部。 -->
        <Grid Grid.Row="1" x:Name="MediaRoot" Background="#000000" ClipToBounds="True"
              PointerMoved="OnMediaPointerMoved" PointerPressed="OnMediaPointerPressed">
            <Image Source="{Binding ImagePath}" Stretch="Uniform" IsVisible="{Binding IsImage}" />
            <vlc:VideoView x:Name="VideoView" IsVisible="{Binding IsVideo}" />

            <!-- 音频舞台：柔和光晕 + 封面 + 标题 -->
            <Grid IsVisible="{Binding IsAudio}" Margin="0,0,0,54">
                <Border Width="460" Height="460" CornerRadius="230" Opacity="0.16"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Background>
                        <RadialGradientBrush>
                            <GradientStop Color="#F97316" Offset="0" />
                            <GradientStop Color="#00F97316" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="620" Spacing="0">
                    <Border Width="210" Height="210" CornerRadius="16" ClipToBounds="True"
                            Background="#171717" BoxShadow="0 18 50 0 #80000000"
                            HorizontalAlignment="Center">
                        <Panel>
                            <PathIcon Data="{StaticResource IconVolume}" Width="84" Height="84"
                                      Foreground="#38FFFFFF" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" IsVisible="{Binding !HasCover}" />
                            <Image Source="{Binding CoverPath}" Stretch="UniformToFill"
                                   IsVisible="{Binding HasCover}" />
                        </Panel>
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold"
                               Foreground="#F2F2F2" TextAlignment="Center" TextWrapping="Wrap"
                               MaxLines="2" Margin="0,22,0,0" />
                    <TextBlock Text="音频播放" FontSize="12" Foreground="#8A8A8A"
                               TextAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>

            <!-- 音频控制条：叠在画面底部，鼠标无操作 3 秒自动淡出，移动鼠标立即出现 -->
            <Border x:Name="AudioBar" VerticalAlignment="Bottom" IsVisible="{Binding IsAudio}"
                    Opacity="{Binding ControlsOpacity}" IsHitTestVisible="{Binding AreControlsVisible}"
                    PointerEntered="OnAudioBarPointerEntered" PointerExited="OnAudioBarPointerExited">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.24" />
                    </Transitions>
                </Border.Transitions>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#00000000" Offset="0" />
                        <GradientStop Color="#CC000000" Offset="0.5" />
                        <GradientStop Color="#F2000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <views:PlayerControls Margin="24,40,24,14" />
            </Border>

            <!-- 图片错误提示（视频/音频的错误显示在控制条里） -->
            <Border Background="#E6202733" CornerRadius="8" Padding="12,8"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0"
                    IsVisible="{Binding ShowMediaError}" MaxWidth="600">
                <TextBlock Text="{Binding Error}" Foreground="#FFFFC7C7" FontSize="12" TextWrapping="Wrap" />
            </Border>
        </Grid>

        <!-- 视频控制条：固定在画面下方一行，原生视频窗口不会遮住它 -->
        <Border Grid.Row="2" IsVisible="{Binding ShowVideoControls}"
                Background="#141414" BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0"
                Padding="16,4,16,8">
            <views:PlayerControls />
        </Border>
    </Grid>
</UserControl>
