<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
        xmlns:local="clr-namespace:VSP.Desktop.Views"
        x:Class="VSP.Desktop.Views.PreviewWindow"
        x:DataType="local:PreviewViewModel"
        Title="预览"
        Width="1000" Height="640" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}">
    <Grid>
        <Image Source="{Binding ImagePath}" Stretch="Uniform" IsVisible="{Binding IsImage}" />
        <vlc:VideoView x:Name="VideoView" IsVisible="{Binding IsVideo}" />

        <Border Background="#E6202733" CornerRadius="8" Padding="16,10"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="{Binding HasError}" MaxWidth="600">
            <TextBlock Text="{Binding Error}" Foreground="#FFFFC7C7" FontSize="13" TextWrapping="Wrap" />
        </Border>

        <Border Background="#E6192231" IsVisible="{Binding IsVideo}"
                VerticalAlignment="Bottom" Padding="14,12">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <Button Grid.Column="0" Content="{Binding PlayPauseText}" Command="{Binding PlayPauseCommand}"
                        Width="72" Height="30" Margin="0,0,10,0" Background="{DynamicResource Accent}" Foreground="White"
                        CornerRadius="5" FontSize="12" />
                <Button Grid.Column="1" Content="停止" Command="{Binding StopCommand}"
                        Width="60" Height="30" Margin="0,0,10,0" Background="#FF334156" Foreground="White"
                        CornerRadius="5" FontSize="12" />
                <TextBlock Grid.Column="2" Text="{Binding PositionText}" Foreground="#FFD8E2F0" FontSize="12"
                           Width="130" VerticalAlignment="Center" />
                <Slider Grid.Column="3" Minimum="0" Maximum="100" Value="{Binding Position, Mode=TwoWay}"
                        Margin="10,0" Height="20" VerticalAlignment="Center" />
                <Button Grid.Column="4" Content="静音" Command="{Binding MuteCommand}"
                        Width="60" Height="30" Background="#FF334156" Foreground="White"
                        CornerRadius="5" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Window>
