<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VSP.Desktop"
             x:Class="VSP.Desktop.Views.QueueView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackground}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,22" MaxWidth="1024">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Grid.Column="0" Classes="ghost small" Command="{Binding BackCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{StaticResource IconBack}" Width="13" Height="13" />
                                <TextBlock Text="返回" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="下载队列" Classes="h1" VerticalAlignment="Center" />
                        <Border Classes="chip" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TaskSummary}" Classes="dim" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="ghost small" Command="{Binding OpenDownloadDirCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{StaticResource IconFolder}" Width="12" Height="12" />
                                <TextBlock Text="打开目录" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost small" Command="{Binding ClearFinishedCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" />
                                <TextBlock Text="清除已完成" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock Text="暂无下载任务" Classes="dim" HorizontalAlignment="Center" Margin="0,70,0,0"
                           IsVisible="{Binding HasNoTasks}" />

                <ItemsControl ItemsSource="{Binding TaskItems}" Margin="0,18,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskItemViewModel">
                            <Border Classes="card" Padding="16,13" Margin="0,0,0,8">
                                <StackPanel Spacing="9">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" Classes="h2"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="dim"
                                                   Margin="12,0,0,0" />
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding ProgressText}" Classes="dim" />
                                        <TextBlock Grid.Column="2" Text="{Binding Speed}" FontSize="12"
                                                   Foreground="{DynamicResource Accent}" FontWeight="SemiBold"
                                                   Margin="10,0,0,0" IsVisible="{Binding HasSpeed}" />
                                    </Grid>
                                    <ProgressBar Classes="bar" Value="{Binding Progress}" Maximum="100" />

                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasError}">
                                        <TextBlock Grid.Column="0" Text="{Binding Error}" Classes="sub"
                                                   Foreground="{DynamicResource Danger}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                            <Button Classes="ghost small" Command="{Binding RetryCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="{StaticResource IconRefresh}" Width="12" Height="12" />
                                                    <TextBlock Text="重试" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="ghost small" Command="{Binding RemoveCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" />
                                                    <TextBlock Text="删除" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                                                IsVisible="{Binding IsRunning}">
                                        <Button Classes="ghost small" Command="{Binding PauseCommand}">
                                            <TextBlock Text="暂停" FontSize="12" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Classes="ghost small" Command="{Binding CancelCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                                                <TextBlock Text="取消" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                                                IsVisible="{Binding IsPaused}">
                                        <Button Classes="ghost small" Command="{Binding ResumeCommand}">
                                            <TextBlock Text="继续" FontSize="12" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Classes="ghost small" Command="{Binding CancelCommand}">
                                            <TextBlock Text="取消" FontSize="12" VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                                                IsVisible="{Binding IsDone}">
                                        <Button Classes="ghost small" Command="{Binding OpenFileCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="{StaticResource IconPlay}" Width="12" Height="12" />
                                                <TextBlock Text="打开文件" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Classes="ghost small" Command="{Binding RemoveCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <PathIcon Data="{StaticResource IconTrash}" Width="12" Height="12" />
                                                <TextBlock Text="移除" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
