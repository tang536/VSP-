<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VSP.Desktop"
             x:Class="VSP.Desktop.Views.StorageView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource AppBackground}">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,22" MaxWidth="1024">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Classes="ghost small" Command="{Binding BackCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{StaticResource IconBack}" Width="13" Height="13" />
                                <TextBlock Text="返回" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="存储管理" Classes="h1" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="ghost small" VerticalAlignment="Center"
                            Command="{Binding RefreshStorageCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource IconRefresh}" Width="12" Height="12" />
                            <TextBlock Text="刷新" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBlock Text="{Binding DownloadDir}" Classes="sub" Margin="2,8,0,0" />

                <!-- 占用空间：缓存 + 已下载文件合计 -->
                <Border Classes="card" Padding="18" Margin="0,18,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="44" Height="44" Background="{DynamicResource AccentSoft}"
                                CornerRadius="2">
                            <PathIcon Data="{StaticResource IconFolder}" Width="20" Height="20"
                                      Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="占用空间" Classes="h2" />
                            <TextBlock Text="缓存与已下载文件合计" Classes="sub" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding StorageTotalText}" FontSize="24"
                                   FontWeight="Bold" Foreground="{DynamicResource Ink}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 磁盘 -->
                <Border Classes="card" Padding="18" Margin="0,10,0,0">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Grid.Column="0" Data="{StaticResource IconImage}" Width="16" Height="16"
                                      Foreground="{DynamicResource InkDim}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="磁盘空间" FontSize="14" Margin="20,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding StoragePercentText}" Classes="dim"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <ProgressBar Classes="bar" Height="6" Value="{Binding StorageUsage}" Maximum="100" />
                        <TextBlock Text="{Binding StorageDiskText}" Classes="dim" />
                    </StackPanel>
                </Border>

                <!-- 缓存 -->
                <Border Classes="card" Padding="18" Margin="0,10,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconImage}" Width="16" Height="16"
                                  Foreground="{DynamicResource InkDim}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="预览缓存" FontSize="14" />
                            <TextBlock Text="{Binding StorageCacheText}" Classes="dim" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="primary small" Command="{Binding ClearCacheCommand}"
                                IsEnabled="{Binding HasCache}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{StaticResource IconTrash}" Width="13" Height="13" />
                                <TextBlock Text="清空缓存" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- 下载文件 -->
                <Border Classes="card" Padding="18" Margin="0,10,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconDownload}" Width="16" Height="16"
                                  Foreground="{DynamicResource InkDim}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="下载文件" FontSize="14" />
                            <TextBlock Text="{Binding StorageDownloadText}" Classes="dim" />
                        </StackPanel>
                        <Button Grid.Column="2" Classes="ghost small" Command="{Binding OpenDownloadDirCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{StaticResource IconFolder}" Width="12" Height="12" />
                                <TextBlock Text="打开目录" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <TextBlock Text="清空缓存只会删除预览用的临时文件，不会影响已经下载的视频和图片。"
                           Classes="sub" Margin="2,14,0,0" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
